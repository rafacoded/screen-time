<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Imagen de portada -->
        <ImageView
            android:id="@+id/ivPortada"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/portada_pelicula" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de la Película"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <!-- Año y género -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2024 · Acción"
            android:textSize="14sp"
            android:textColor="#777777"
            android:paddingTop="4dp" />

        <!-- RatingBar (solo muestra la nota) -->
        <RatingBar
            android:id="@+id/rbPuntuacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:isIndicator="true"
            android:paddingTop="8dp" />

        <!-- Chips de estado -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPendiente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendiente"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipViendo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viendo"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vista"
                android:checkable="true" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="16dp" />

        <!-- Botón abrir/añadir review -->
        <Button
            android:id="@+id/btnReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Añadir review"
            android:layout_marginTop="16dp" />

        <!-- Botón recordatorio -->
        <Button
            android:id="@+id/btnRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar recordatorio"
            android:layout_marginTop="8dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="16dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción de la película..."
            android:textSize="16sp"
            android:paddingTop="16dp" />

    </LinearLayout>

</ScrollView>
